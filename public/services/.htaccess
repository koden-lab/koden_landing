
# Si el archivo solicitado sin .html no existe pero con .html sí, lo redirigimos
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# Opcional: Redirigir las URL con .html a la versión sin .html para SEO
RewriteCond %{THE_REQUEST} \s/([^/]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]
